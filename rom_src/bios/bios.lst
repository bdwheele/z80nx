 146:				    ; DPBASE is the start of the Disk Parameter Header.  It's public because
 147:				    ; the emulator may need to touch it or some of the things it refers to.
 148:				
 149:				    public DPBASE
 150:     -	00A4'         	DPBASE:
 151:     -	00A4'         	drive_a_dph:
 152:     -	00A4' 0000    	    dw 0            ; Sector translation vector
 153:     -	00A6' 00000000	    dw 0, 0, 0      ; BDOS scratchpad
	              0000
 154:     -	00AC' E602    	    dw dirbuf       ; Directory scratchpad
 155:     -	00AE' D400    	    dw fd1440k      ; Drive parameter block
 156:     -	00B0' A602    	    dw drive_a_check_vector ; Disk change check vector
 157:     -	00B2' F200    	    dw drive_a_bitmap ; Allocation bitmap
 158:     -	00B4'         	drive_b_dph:
 159:     -	00B4' 0000    	    dw 0            ; Sector translation vector
 160:     -	00B6' 00000000	    dw 0, 0, 0      ; BDOS scratchpad
	              0000
 161:     -	00BC' E602    	    dw dirbuf       ; Directory scratchpad
 162:     -	00BE' D400    	    dw fd1440k      ; Drive parameter block
 163:     -	00C0' C602    	    dw drive_b_check_vector ; Disk change check vector
 164:     -	00C2' 4C01    	    dw drive_b_bitmap ; Allocation bitmap
 165:     -	00C4'         	drive_c_dph:
 166:     -	00C4' 0000    	    dw 0            ; Sector translation vector
 167:     -	00C6' 00000000	    dw 0, 0, 0      ; BDOS scratchpad
	              0000
 168:     -	00CC' E602    	    dw dirbuf       ; Directory scratchpad
 169:     -	00CE' E300    	    dw hd32m        ; Drive parameter block
 170:     -	00D0' 0000    	    dw 0            ; Disk change check vector: none as this is a fixed disk
 171:     -	00D2' A601    	    dw drive_c_bitmap ; Allocation bitmap
 172:				
 173:     -	05A0'         	FD1440_SIZE = 1440 ; kb
 174:     -	02D0'         	FD1440_BLOCKS = FD1440_SIZE / 2 ; 2kB blocks, no reserved tracks
 175:     -	00D4'         	fd1440k:            ; disk parameter block for a 1.44M floppy
 176:     -	00D4' 4800    	    dw 18*4         ; Number of CP/M sectors per track
 177:     -	00D6' 040F    	    db 4, 15        ; BSH/BLM for 2048-byte blocks
 178:     -	00D8' 00      	    db 0            ; EXM for 2048-byte allocation units and >255 blocks
 179:     -	00D9' CF02    	    dw FD1440_BLOCKS-1 ; DSM
 180:     -	00DB' 7F00    	    dw 127          ; DRM, one fewer than the number of directory entries
 181:     -	00DD' C000    	    db 0xc0, 0x00   ; Initial allocation vector for two directory blocks
 182:     -	00DF' 2000    	    dw 32           ; Size of disk change check vector: (DRM+1)/4
 183:     -	00E1' 0000    	    dw 0            ; Number of reserved tracks
 184:				
 185:     -	8000'         	HD32M_SIZE = 32*1024             ; kB; this is the *maximum* size
 186:     -	0800'         	HD32M_BLOCKS = HD32M_SIZE / 16 ; 16kB blocks, no reserved tracks
 187:     -	00E3'         	hd32m:
 188:				    ;dw 256*4        ; Number of CP/M sectors per track
 189:     -	00E3' 4000    	    dw 64           ; Number of CP/M sectors per track
 190:     -	00E5' 077F    	    db 7, 127       ; BSH/BLM for 16384-byte blocks
 191:     -	00E7' 07      	    db 7            ; EXM for 16384-byte allocation units and >255 blocks
 192:     -	00E8' FF07    	    dw HD32M_BLOCKS-1 ; DSM
 193:     -	00EA' FF01    	    dw 511          ; DRM, one fewer than the number of directory entries
 194:     -	00EC' 8000    	    db 0x80, 0x00   ; Initial allocation vector for one directory block
 195:     -	00EE' 0000    	    dw 0            ; Size of disk change check vector: zero as this is a fixed disk
 196:     -	00F0' 0000    	    dw 0            ; Number of reserved tracks
